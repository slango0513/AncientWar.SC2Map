                TriggerEnable(libGAwX_gt_ankhAnkhofReincarnationRemove, true);
                TriggerExecute(gt_Waiting, true, false);
            }

        }

    }
    else {
        if ((gv_intBonusRound <= gv_intCountBonusRound)) {
