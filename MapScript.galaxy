        TimerWindowCreate(TimerLastStarted(), StringExternal("Param/Value/91DF5681"), true, false);
        Wait(gv_fixedTime, c_timeGame);
    }
    TimerWindowDestroy(TimerWindowLastCreated());
    VisEnable(c_visTypeMask, false);
    VisEnable(c_visTypeFog, false);
    TriggerExecute(gt_AI, true, false);
    return true;
}

