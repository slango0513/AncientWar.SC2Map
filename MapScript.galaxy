    VisEnable(c_visTypeMask, true);
    VisEnable(c_visTypeFog, true);
    TriggerEnable(gt_Reserve, false);
    auto3A4EFC67_ae = gv_intCountPlayer;
    auto3A4EFC67_ai = 1;
    lv_p = 1;
    for ( ; ( (auto3A4EFC67_ai >= 0 && lv_p <= auto3A4EFC67_ae) || (auto3A4EFC67_ai <= 0 && lv_p >= auto3A4EFC67_ae) ) ; lv_p += auto3A4EFC67_ai ) {
        libNtve_gf_SetUpgradeLevelForPlayer(gv_intPlayer[lv_p], "Pause", 1);
        if ((gv_intBonusRound == gv_intCountBonusRound)) {
            libNtve_gf_SetUpgradeLevelForPlayer(gv_intPlayer[lv_p], "Final", 1);
        }

        VisRevealerEnable(gv_visRevealer[gv_intPlayer[lv_p]], true);
        PlayerModifyPropertyInt(gv_intPlayer[lv_p], c_playerPropTerrazine, c_playerPropOperAdd, gv_intG[gv_intRound]);
        PlayerModifyPropertyInt(gv_intPlayer[lv_p], c_playerPropCustom, c_playerPropOperAdd, gv_intSL[gv_intPlayer[lv_p]]);
        CameraPan(gv_intPlayer[lv_p], gf_PlayerBuildingLocation(gv_intPlayer[lv_p]), 1.0, -1, 10.0, false);
    }
    if ((gv_intBonusRound == gv_intCountBonusRound)) {
        TimerStart(TimerCreate(), 90.0, false, c_timeGame);
        TimerWindowCreate(TimerLastStarted(), StringExternal("Param/Value/781AF07E"), true, false);
        Wait(90.0, c_timeGame);
    }
    else {
