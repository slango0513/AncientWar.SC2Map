//--------------------------------------------------------------------------------------------------
// Trigger: Reserve
//--------------------------------------------------------------------------------------------------
bool gt_Reserve_Func (bool testConds, bool runActions) {
    int auto33A120BB_ae;
    int auto33A120BB_ai;
    int auto3D1BE2E6_ae;
    int auto3D1BE2E6_ai;
    int auto1D1DAF8F_ae;
    int auto1D1DAF8F_ai;
    int autoA5DAEA43_ae;
    int autoA5DAEA43_ai;

    // Variable Declarations
    int lv_i;
    int lv_p;
    int lv_pL;
    int lv_pWn;
    int lv_pLs;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeSummoned) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((libNtve_gf_KillingPlayer() != 15)) {
        gv_intS[libNtve_gf_KillingPlayer()] += CatalogFieldValueGetAsInt(c_gameCatalogUnit, UnitGetType(EventUnit()), "KillResource[" + IntToString(3) + "]", EventPlayer());
        BoardItemSetText(gv_board, 3, gv_intRowBoardOfPlayer[libNtve_gf_KillingPlayer()], IntToText(gv_intS[libNtve_gf_KillingPlayer()]));
        BoardItemSetProgressValue(gv_board, 3, gv_intRowBoardOfPlayer[libNtve_gf_KillingPlayer()], gv_intS[libNtve_gf_KillingPlayer()]);
        if ((gv_intS[libNtve_gf_KillingPlayer()] > gv_intSMax)) {
            gv_intSMax = gv_intS[libNtve_gf_KillingPlayer()];
        }

        auto33A120BB_ae = gv_intCountPlayer;
        auto33A120BB_ai = 1;
        lv_p = 1;
        for ( ; ( (auto33A120BB_ai >= 0 && lv_p <= auto33A120BB_ae) || (auto33A120BB_ai <= 0 && lv_p >= auto33A120BB_ae) ) ; lv_p += auto33A120BB_ai ) {
            BoardItemSetProgressRange(gv_board, 3, lv_p, 0.0, gv_intSMax);
        }
    }

    if ((EventPlayer() != 15)) {
        gv_intCountLivingUnit[EventPlayer()] -= 1;
        lv_i = ((gv_intCountUnit[EventPlayer()] - gv_intCountLivingUnit[EventPlayer()]) + (gv_intColumn * gv_intRow));
        if ((lv_i <= gv_intCountUnit[EventPlayer()])) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, gv_typeUnit[EventPlayer()][lv_i], c_unitCreateIgnorePlacement, EventPlayer(), gv_pointReserve[EventPlayer()]);
            UnitSetFacing(UnitLastCreated(), PointGetFacing(gf_PlayerReserveLocation(EventPlayer())), 0.0);
            UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("attack", 0), RegionGetCenter(RegionFromId(1))), c_orderQueueReplace);
            libNtve_gf_MakeUnitUncommandable(UnitLastCreated(), true);
        }

    }

    if ((gv_intRound <= gv_intCountRound)) {
        if ((gv_boolKilling == false)) {
            autoA5DAEA43_ae = gv_intCountPlayer;
            autoA5DAEA43_ai = 1;
            lv_p = 1;
            for ( ; ( (autoA5DAEA43_ai >= 0 && lv_p <= autoA5DAEA43_ae) || (autoA5DAEA43_ai <= 0 && lv_p >= autoA5DAEA43_ae) ) ; lv_p += autoA5DAEA43_ai ) {
                if ((gv_intCountLivingUnit[gv_intPlayer[lv_p]] != 0)) {
                    lv_pL += 1;
                    lv_pWn = gv_intPlayer[lv_p];
                }

            }
            if ((lv_pL == 1)) {
                gv_boolKilling = true;
                Wait(2.0, c_timeGame);
                while (true) {
                    if ((gv_intCountLivingUnit[lv_pWn] != 0)) {
                        UnitGroupLoopBegin(UnitGroup(null, c_playerAny, RegionFromId(1), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
                        for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
                            PlayerModifyPropertyInt(lv_pWn, c_playerPropCustom, c_playerPropOperAdd, CatalogFieldValueGetAsInt(c_gameCatalogUnit, UnitGetType(UnitGroupLoopCurrent()), "KillResource[" + IntToString(3) + "]", lv_pWn));
                            PlayerCreateEffectUnit(lv_pWn, "Kill", UnitGroupLoopCurrent());
                            Wait(0.0625, c_timeGame);
                        }
                        UnitGroupLoopEnd();
                    }
                    else {
                        break;
                    }
                }
                Wait(2.0, c_timeGame);
                gv_boolKilling = false;
                TriggerExecute(gt_Waiting, true, false);
            }

        }

    }
    else {
        if ((gv_intBonusRound <= gv_intCountBonusRound)) {
            auto1D1DAF8F_ae = gv_intCountPlayer;
            auto1D1DAF8F_ai = 1;
            lv_p = 1;
            for ( ; ( (auto1D1DAF8F_ai >= 0 && lv_p <= auto1D1DAF8F_ae) || (auto1D1DAF8F_ai <= 0 && lv_p >= auto1D1DAF8F_ae) ) ; lv_p += auto1D1DAF8F_ai ) {
                if ((gv_intCountLivingUnit[gv_intPlayer[lv_p]] != 0)) {
                    lv_pL += 1;
                }

            }
            if ((gv_intCountLivingUnit[EventPlayer()] == 0)) {
                PlayerGroupAdd(gv_playergroupBonusDone, EventPlayer());
            }

            if ((lv_pL == 0)) {
                Wait(2.0, c_timeGame);
                UnitGroupLoopBegin(UnitGroup(null, 15, RegionFromId(1), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
                for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
                    UnitRemove(UnitGroupLoopCurrent());
                }
                UnitGroupLoopEnd();
                Wait(2.0, c_timeGame);
                if ((gv_intBonusRound == gv_intCountBonusRound)) {
                    TriggerExecute(gt_Waiting, true, false);
                }
                else {
                    TriggerExecute(gt_InitUnit, true, false);
                }
            }

        }
        else {
            if ((gv_intFinalRound <= gv_intCountFinalRound)) {
                auto3D1BE2E6_ae = gv_intCountPlayer;
                auto3D1BE2E6_ai = 1;
                lv_p = 1;
                for ( ; ( (auto3D1BE2E6_ai >= 0 && lv_p <= auto3D1BE2E6_ae) || (auto3D1BE2E6_ai <= 0 && lv_p >= auto3D1BE2E6_ae) ) ; lv_p += auto3D1BE2E6_ai ) {
                    if ((gv_intCountLivingUnit[gv_intPlayer[lv_p]] != 0)) {
                        lv_pL += 1;
                        lv_pWn = gv_intPlayer[lv_p];
                    }

                }
                if ((lv_pL == 1)) {
                    if ((gv_intFinalRound == gv_intCountFinalRound)) {
                        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (TextWithColor(PlayerName(lv_pWn), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(lv_pWn, false))) + StringExternal("Param/Value/6250BEB1")));
                        Wait(15.0, c_timeGame);
                        PlayerGroupLoopBegin(PlayerGroupActive());
                        for ( ; !PlayerGroupLoopDone() ; PlayerGroupLoopStep() ) {
                            if ((PlayerGroupLoopCurrent() == lv_pWn)) {
                                GameOver(PlayerGroupLoopCurrent(), c_gameOverVictory, true, true);
                            }
                            else {
                                GameOver(PlayerGroupLoopCurrent(), c_gameOverDefeat, true, true);
                            }
                        }
                        PlayerGroupLoopEnd();
                    }
                    else {
                        lv_pLs = EventPlayer();
                        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (TextWithColor(PlayerName(lv_pWn), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(lv_pWn, false))) + StringExternal("Param/Value/171BD6C0")));
                        PlayerGroupAdd(gv_playergroupWon, lv_pWn);
                        PlayerGroupAdd(gv_playergroupLose, lv_pLs);
                        BoardItemSetTextColor(gv_board, 1, gv_intRowBoardOfPlayer[lv_pLs], Color(100.00, 100.00, 100.00));
                        BoardItemSetTextColor(gv_board, 2, gv_intRowBoardOfPlayer[lv_pLs], Color(0.00, 0.00, 0.00));
                        BoardItemSetProgressColor(gv_board, 2, gv_intRowBoardOfPlayer[lv_pLs], Color(100.00, 100.00, 100.00), 1);
                        BoardItemSetTextColor(gv_board, 3, gv_intRowBoardOfPlayer[lv_pLs], Color(0.00, 0.00, 0.00));
                        BoardItemSetProgressColor(gv_board, 3, gv_intRowBoardOfPlayer[lv_pLs], Color(100.00, 100.00, 100.00), 1);
                        Wait(2.0, c_timeGame);
                        UnitGroupLoopBegin(UnitGroup(null, c_playerAny, RegionFromId(1), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
                        for ( ; !UnitGroupLoopDone() ; UnitGroupLoopStep() ) {
                            UnitRemove(UnitGroupLoopCurrent());
                        }
                        UnitGroupLoopEnd();
                        Wait(2.0, c_timeGame);
                        TriggerExecute(gt_InitUnit, true, false);
                    }
                }

            }

        }
    }
    return true;
}

