                            BankValueSetFromInt(gv_bank[PlayerGroupLoopCurrent()], "Score", "GameCount", (BankValueGetAsInt(gv_bank[PlayerGroupLoopCurrent()], "Score", "GameCount") + 1));
                            if ((PlayerGroupLoopCurrent() == lv_pWn)) {
